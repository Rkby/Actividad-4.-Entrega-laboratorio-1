2026-11-09 02:58:33.129 GMT [22032] user=postgres db=comercial app=admin-verificacion client=127.0.0.1 LOG:  sentencia: CREATE OR REPLACE FUNCTION auditoria.registrar_cambio_cliente()
	RETURNS trigger
	LANGUAGE plpgsql
	SECURITY DEFINER
	SET search_path = pg_catalog, public
	AS $$
	BEGIN
	
	    IF TG_OP = 'INSERT' THEN
	
	        INSERT INTO auditoria.cambios_clientes
	            (operacion, id_cliente, valores_despues)
	        VALUES
	            (TG_OP, NEW.id, to_jsonb(NEW));
	
	        RETURN NEW;
	
	    ELSIF TG_OP = 'UPDATE' THEN
	
	        INSERT INTO auditoria.cambios_clientes
	            (operacion, id_cliente, valores_antes, valores_despues)
	        VALUES
	            (TG_OP, NEW.id, to_jsonb(OLD), to_jsonb(NEW));
	
	        RETURN NEW;
	
	    ELSIF TG_OP = 'DELETE' THEN
	
	        INSERT INTO auditoria.cambios_clientes
	            (operacion, id_cliente, valores_antes)
	        VALUES
	            (TG_OP, OLD.id, to_jsonb(OLD));
	
	        RETURN OLD;
	
	    END IF;
	
	    RETURN NULL;
	
	END;
	$$;
